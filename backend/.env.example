# BhashaAI Environment Configuration
PROJECT_NAME="BhashaAI"
VERSION="1.0.0"

# Security
SECRET_KEY="replace_with_a_secure_random_secret_key_minimum_32_characters"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL 18 Database Credentials
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"
POSTGRES_DB="bhashaai"
POSTGRES_PORT=5432

# Deep Learning Models
WHISPER_MODEL_NAME="openai/whisper-small"
NMT_MODEL_NAME="facebook/nllb-200-distilled-600M"
USE_GPU=false

# Storage & Audio Limits
MAX_UPLOAD_SIZE_MB=25
SAMPLE_RATE=16000

