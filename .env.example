# ==============================================================================
# BhashaAI - Environment Configuration Template (.env.example)
# Copy this file to '.env' and update values for your local or production environment.
# ==============================================================================

# Application Metadata
PROJECT_NAME="BhashaAI"
VERSION="2.0.0"
API_V1_STR="/api/v1"

# Security & Authentication
# Replace with a cryptographically secure random key in production (e.g., `openssl rand -hex 32`)
SECRET_KEY="bhashaai_super_secret_jwt_key_2026_mca_project_secure_hash"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Supabase PostgreSQL or Local SQLite)
# Supabase Pooler Connection (Recommended for hosted Supabase):
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"

# Supabase API Credentials (Optional, for Supabase Client & Storage):
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_STORAGE_BUCKET="bhashaai-audio"

# Traditional PostgreSQL Database Configuration (Alternative)
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"
POSTGRES_DB="bhashaai"
POSTGRES_PORT=5432

# Audio Storage Directories & Upload Limits
STORAGE_DIR="storage/audio"
MAX_UPLOAD_SIZE_MB=25

# Deep Learning Models Configuration
# Whisper options: 'openai/whisper-tiny', 'openai/whisper-base', 'openai/whisper-small'
WHISPER_MODEL_NAME="openai/whisper-small"

# NMT options: 'facebook/nllb-200-distilled-600M', 'ai4bharat/indictrans2-indic-indic-dist-320M'
NMT_MODEL_NAME="facebook/nllb-200-distilled-600M"

# Hardware Acceleration (Set to True if CUDA-compatible GPU is available)
USE_GPU=False

# Cross-Origin Resource Sharing (CORS)
# For production, specify your frontend domain e.g. ["https://bhashaai.vercel.app"]
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
